################### {Beat} Configuration Example #########################

############################# {Beat} ######################################

tropobeat:
  # How often weather is fetched from Open-Meteo for every co-channel path
  # point and every LRF without paths. The first poll runs at start-up.
  # Each poll costs Open-Meteo API calls per location (see the rolling plan,
  # Q15), so check your plan's limits before shortening it.
  period: 1h

  # Limit tropobeat to these LRF codes, for limited runs and testing. Only
  # these LRFs' co-channel paths are discovered and only their weather is
  # fetched. Empty or unset means all LRFs.
  #lrf_sites: ["TERH", "PROV"]

  # Elasticsearch cluster that tropobeat reads reference data from (the LRF
  # sites loaded with `tropobeat insert lrfcoordinates`). This is separate
  # from the output where events are published.
  elasticsearch:
    hosts: ["http://localhost:9200"]
    # Store credentials in the keystore rather than in this file:
    #   tropobeat keystore add ES_PASSWORD
    #username: "tropobeat"
    #password: "${ES_PASSWORD}"
    #api_key: "${ES_API_KEY}"

  # Index holding the LRF sites.
  #lrf_index: "lrf-coordinates"

  # Index pattern holding the demod telemetry, used to find the RF channels
  # (and call signs) each LRF receives.
  #demod_index: "log-metric-p-rfdemod-*"

  # Index holding the FCC transmitters loaded with
  # `tropobeat insert fcctransmitters`. Schedule that import (cron) before
  # cochannel.schedule, e.g. at 02:00 UTC, so discovery reads a complete list.
  #fcc_index: "fcc-transmitters"

  # Daily co-channel discovery: for each LRF and received RF channel, find
  # same-channel transmitters within the radius, excluding the LRF's own
  # station. Also runs once at start-up.
  cochannel:
    # Cron expression, UTC.
    schedule: "0 3 * * *"
    # Search radius around each LRF.
    radius: "200mi"

  # Open-Meteo weather API (https://open-meteo.com).
  openmeteo:
    # Set to false to turn weather polling off: tropobeat then only runs the
    # daily co-channel discovery and makes no Open-Meteo calls.
    #enabled: true

    # API key for Open-Meteo commercial plans. Leave unset to use the free
    # API, which is for non-commercial use only. When set, requests go to
    # customer-api.open-meteo.com. Store the key in the keystore rather than
    # in this file:
    #   tropobeat keystore add OPENMETEO_API_KEY
    #api_key: "${OPENMETEO_API_KEY}"

    # Override the API endpoint, e.g. for a self-hosted Open-Meteo instance.
    #url: ""

    # Mock weather, for building and testing dashboards: serve simulated
    # weather instead of calling Open-Meteo. Weather and ducting events are
    # then simulated and tagged "mock-weather"; co-channel paths stay real.
    #mock:
      #enabled: false
      # mixed (every location cycles through all states, varying with
      # place), or one state everywhere: normal, super_refractive, ducting
      # (thin, traps nothing), elevated, trapped_uhf, trapped (traps VHF too),
      # no_data (no values: insufficient data).
      #scenario: mixed
      # mixed only: how long each location takes to pass through every state.
      #cycle: 6h
      # Per-LRF scenarios, applied to every point of the LRF's co-channel
      # paths, to line ducting up with replayed test telemetry.
      #sites:
        #TERH: trapped
        #BOS: normal
      # Fail every poll for fail_for at the start of every fail_every, so
      # the ducting results go stale. 0 = never.
      #fail_every: 0
      #fail_for: 0

  # Ducting calculation, run on every weather poll (see DUCTING.md).
  # "all" publishes a ducting event for every location on every poll;
  # "notable" only for super-refractive and ducting locations.
  #ducting:
    #publish: all

  # Daily demod baselines: the median Pre-FEC BER and MER of every demod
  # instance (host IP, slot and input) and RF channel, from the last
  # window_days whole days of demod telemetry. Live telemetry is judged
  # against them. Also runs once at start-up.
  #baseline:
    # Cron expression, UTC. Run after co-channel discovery.
    #schedule: "30 3 * * *"
    #window_days: 7
    # Fewest locked reports (about one a minute) for a usable baseline.
    #min_samples: 1440
    # Smallest BER baseline: most medians are 0, so a spike is measured
    # against max(median, ber_floor).
    #ber_floor: 1e-6
    # Treat the baselines as missing once they are this old (failed runs).
    #max_age: 48h
    # Publish each run's baselines as the baseline metricset.
    #publish: true

  # Live demod reports from RabbitMQ. Tropobeat declares its own queue,
  # bound to the demod exchange, and keeps it bounded (reports older than
  # message_ttl expire; beyond max_length the oldest are dropped).
  rabbitmq:
    #enabled: false
    #host: "localhost"
    #port: 8910
    #vhost: "/"
    #username: "insite"
    # Required when enabled. Store it in the keystore rather than in this file:
    #   tropobeat keystore add RABBITMQ_PASSWORD
    #password: "${RABBITMQ_PASSWORD}"
    #ssl:
      #enabled: false
      #ca_cert: "/etc/tropobeat/rabbitmq-ca.pem"
      # For testing only.
      #insecure: false

    # The exchange the demod reports are published to. With
    # exchange_declare "passive" (default) tropobeat only checks that it
    # exists with this type and durability; "active" creates it, for
    # development and replay setups.
    #exchange: "x.tropobeat.demod"
    #exchange_type: "direct"
    #exchange_declare: "passive"
    #durable: true
    #routing_key: "demod.metrics"
    #queue: "q.tropobeat.demod"

    # Unacknowledged reports the broker sends ahead.
    #prefetch: 500
    #message_ttl: 5m
    #max_length: 50000
    # Reconnect delay: starts at reconnect_interval and doubles on each
    # failure up to reconnect_max.
    #reconnect_interval: 1s
    #reconnect_max: 30s

  # The correlation engine: judges each live demod report against its
  # baseline, pairs the side A and B demods of each LRF and RF channel, and
  # confirms co-channel interference (CCI) when both sides are degraded and
  # a co-channel path on the channel is ducting. Runs only with rabbitmq
  # enabled. See CORRELATION.md.
  #correlator:
    #enabled: true
    # Publish verdicts as the correlation metricset.
    #publish: true
    # BER spike: BER at least ber_factor x the baseline's effective BER.
    #ber_factor: 10
    # MER drop: MER at least mer_drop_db below the baseline median.
    #mer_drop_db: 3
    # Reports in a row needed to become degraded, and to clear.
    #hysteresis_cycles: 3
    # Decision trace, published as the correlation_trace metricset:
    # input, skip, hysteresis, pair, ducting, sweep. [] turns it off.
    #trace:
      #categories: [pair, hysteresis]
      # Limit tracing to these LRF codes (empty = all). Use this with the
      # input category, which records every report.
      #lrf_sites: []
