################### {Beat} Configuration Example #########################

############################# {Beat} ######################################

tropobeat:
  # How often weather is fetched from Open-Meteo for every co-channel path
  # point and every LRF without paths. The first poll runs at start-up.
  # Each poll costs Open-Meteo API calls per location (see the rolling plan,
  # Q15), so check your plan's limits before shortening it.
  period: 1h

  # Limit tropobeat to these LRF codes, for limited runs and testing. Only
  # these LRFs' co-channel paths are discovered and only their weather is
  # fetched. Empty or unset means all LRFs.
  #lrf_sites: ["TERH", "PROV"]

  # Elasticsearch cluster that tropobeat reads reference data from (the LRF
  # sites loaded with `tropobeat insert lrfcoordinates`). This is separate
  # from the output where events are published.
  elasticsearch:
    # Elasticsearch host URLs.
    hosts: ["http://localhost:9200"]

    # Basic authentication. Store the password in the keystore rather than in
    # this file:
    #   tropobeat keystore add ES_PASSWORD
    #username: "tropobeat"
    #password: "${ES_PASSWORD}"

    # API key (base64-encoded id:api_key), as an alternative to username and
    # password.
    #api_key: "${ES_API_KEY}"

    # Path to a PEM CA certificate to trust for HTTPS connections.
    #ca_cert: ""

    # Skip TLS certificate verification. Not recommended for production.
    #insecure: false

  # Index holding the LRF sites.
  #lrf_index: "lrf-coordinates"

  # Index pattern holding the demod telemetry, used to find the RF channels
  # (and call signs) each LRF receives.
  #demod_index: "log-metric-p-rfdemod-*"

  # Index holding the FCC transmitters loaded with
  # `tropobeat insert fcctransmitters`. Schedule that import (cron) before
  # cochannel.schedule, e.g. at 02:00 UTC, so discovery reads a complete list.
  #fcc_index: "fcc-transmitters"

  # Daily co-channel discovery: for each LRF and received RF channel, find
  # same-channel transmitters within the radius, excluding the LRF's own
  # station. Also runs once at start-up.
  cochannel:
    # Cron expression, UTC.
    schedule: "0 3 * * *"
    # Search radius around each LRF.
    radius: "200mi"
    # How far back demod telemetry is read to find each LRF's channels.
    #demod_window: 24h

  # Open-Meteo weather API (https://open-meteo.com).
  openmeteo:
    # Set to false to turn weather polling off: tropobeat then only runs the
    # daily co-channel discovery and makes no Open-Meteo calls.
    #enabled: true

    # API key for Open-Meteo commercial plans. Leave unset to use the free
    # API, which is for non-commercial use only. When set, requests go to
    # customer-api.open-meteo.com. Store the key in the keystore rather than
    # in this file:
    #   tropobeat keystore add OPENMETEO_API_KEY
    #api_key: "${OPENMETEO_API_KEY}"

    # Override the API endpoint, e.g. for a self-hosted Open-Meteo instance.
    # Defaults to https://api.open-meteo.com/v1/forecast, or
    # https://customer-api.open-meteo.com/v1/forecast when api_key is set.
    #url: ""

    # Weather models to query. Empty uses Open-Meteo's best_match.
    #models: []

    # Pressure levels (hPa) requested for each atmospheric profile, in
    # addition to the surface (2 m temperature/humidity, surface pressure).
    #pressure_levels: [1000, 975, 950, 925, 900, 850, 800, 700]

    # Number of coordinates sent in each API request.
    #batch_size: 50

    # Days of hourly forecast data to request.
    #forecast_days: 1

    # Timeout for each API request.
    #timeout: 10s

    # Pause between batch requests.
    #batch_delay: 100ms

    # Retries after a rate-limit (429), server (5xx) or network error.
    #max_retries: 2

    # Merge points closer than about this many degrees (rounding before
    # de-duplication), so nearby path points are fetched once and Open-Meteo
    # API usage drops. 0.01 is about 1.1 km. Values above 0.1 may merge
    # points in different weather-model grid cells. 0 = off.
    #coordinate_precision: 0

  # Ducting calculation, run on every weather poll (see DUCTING.md).
  #ducting:
    # Which locations get a ducting event: "all" (every location on every
    # poll, including normal ones) or "notable" (only super-refractive and
    # ducting locations). Weather events carry the ducting summary for
    # every point either way.
    #publish: all

    # Pressure levels closer than this many metres to the point below are
    # dropped, since a tiny height difference makes gradients noisy.
    #min_layer_m: 20

    # Score bands: the steepest gradient dN/dh (N-units per km) maps to a
    # score of 0 at super_refractive_n_per_km, ducting_score at
    # ducting_n_per_km, and 1 at strong_n_per_km. Initial values, to be
    # calibrated.
    #score:
      #super_refractive_n_per_km: -79
      #ducting_n_per_km: -157
      #strong_n_per_km: -300
      #ducting_score: 0.6
